# Generate a pair with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# The client reads the public key from the server by default. Set this to bake
# it into the build instead.
# VITE_VAPID_PUBLIC_KEY=

# Where the client posts subscriptions. Defaults to /api (proxied in dev).
# VITE_PUSH_API_URL=/api
