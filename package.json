{
  "name": "lane-log",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lane Log - installable bowling log PWA with device notifications and score sheet scanning",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "push:keys": "web-push generate-vapid-keys --json",
    "push:server": "node server/index.mjs",
    "vendor:ocr": "node scripts/vendor-ocr.mjs",
    "prebuild": "node scripts/vendor-ocr.mjs && node scripts/vendor-font.mjs",
    "predev": "node scripts/vendor-ocr.mjs && node scripts/vendor-font.mjs",
    "verify:scanner": "node scripts/verify-scanner.mjs",
    "verify:app": "node scripts/verify-app.mjs",
    "vendor:font": "node scripts/vendor-font.mjs",
    "serve:headers": "node scripts/serve-with-headers.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
